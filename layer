        S.cracks.forEach(function(cr){cr.life-=cr.decay;cr.ph+=cr.phs;var a=cr.al*cr.life*(.55+.45*Math.sin(cr.ph));function dCrack(flip){CTX.save();if(flip){CTX.translate(W,0);CTX.scale(-1,1);}CTX.strokeStyle='rgba(255,24,24,'+(a*(flip?.45:1))+')';CTX.lineWidth=flip?.55:.88;CTX.beginPath();cr.pts.forEach(function(pt,i){i?CTX.lineTo(pt.x,pt.y):CTX.moveTo(pt.x,pt.y);});CTX.shadowBlur=6;CTX.shadowColor='rgba(255,0,0,'+a+')';CTX.stroke();CTX.shadowBlur=0;CTX.restore();}dCrack(false);dCrack(true);});
        S.glitchT--;
        if(S.glitchT<=0){S.glitchT=ri(6,44);var nb=ri(1,6);for(var nb2=0;nb2<nb&&S.glitchBars.length<14;nb2++){S.glitchBars.push({y:r(0,H),h:r(1,15),life:r(.2,.9),shift:r(-65,65),al:r(.03,.12),type:ri(0,3)});}if(Math.random()<.3)S.rgbLife=r(.3,.9);}
        if(S.rgbLife>0){S.rgbLife-=.05;var rA=.022*S.rgbLife;CTX.fillStyle='rgba(255,0,0,'+rA+')';CTX.fillRect(r(-12,12),0,W,H);CTX.fillStyle='rgba(0,180,255,'+(rA*.36)+')';CTX.fillRect(r(-8,8),0,W,H);}
        S.glitchBars=S.glitchBars.filter(function(b){return b.life>0;});
        S.glitchBars.forEach(function(b){b.life-=.05;var a=b.al*b.life;CTX.fillStyle='rgba(255,24,24,'+a+')';CTX.fillRect(0,b.y,W,b.h);if(b.type===1){CTX.fillStyle='rgba(255,100,60,'+(a*.5)+')';CTX.fillRect(b.shift,b.y,W*.55,b.h*.6);}else if(b.type===2){for(var p=0;p<20;p++){CTX.fillStyle='rgba(255,24,24,'+(a*r(.4,1.9))+')';CTX.fillRect(r(0,W),b.y+r(-b.h,b.h),r(2,24),r(1,5));}}});
        S.shards.forEach(function(sh,idx){sh.ph+=sh.spd;sh.life-=sh.decay;sh.rot+=sh.rotV;sh.cx+=sh.vx;sh.cy+=sh.vy;if(sh.life<=0){S.shards[idx]=mkShard();return;}var a=sh.al*sh.life*(.46+.54*Math.sin(sh.ph));var cr2=Math.cos(sh.rot),sr=Math.sin(sh.rot);var ox=sh.pts[0].x,oy=sh.pts[0].y;var tp=sh.pts.map(function(pt){var dx=pt.x-ox,dy=pt.y-oy;return{x:sh.cx+cr2*dx-sr*dy,y:sh.cy+sr*dx+cr2*dy};});function dShard(flip){CTX.save();if(flip){CTX.translate(W,0);CTX.scale(-1,1);}CTX.beginPath();CTX.moveTo(tp[0].x,tp[0].y);for(var p=1;p<tp.length;p++)CTX.lineTo(tp[p].x,tp[p].y);CTX.closePath();CTX.strokeStyle='rgba(255,24,24,'+(a*(flip?.6:1))+')';CTX.lineWidth=flip?.5:.92;CTX.stroke();CTX.fillStyle='rgba(255,24,24,'+(a*(flip?.04:.1))+')';CTX.fill();CTX.restore();}dShard(false);dShard(true);});
