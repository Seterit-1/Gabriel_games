<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>ULTRAKILL // СЕКТОРЫ — SYSTEM DATABASE</title>
    <link href="https://fonts.googleapis.com/css2?family=VT323&family=Share+Tech+Mono&family=Fira+Code:wght@400;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --acc:       #ff2020;
            --acc-dim:   #8a0000;
            --acc-glow:  rgba(255,32,32,0.35);
            --body-bg:   #060606;
            --panel-bg:  #0b0b0b;
            --panel-hd:  #0f0f0f;
            --panel-bd:  #222222;
            --text-p:    #e8e8e8;
            --text-1:    #555555;
            --text-2:    #333333;
            --text-3:    #282828;
            --text-4:    #1e1e1e;
            --ticker-bg: #000000;
            --read-bg:   #050505;
            --c-gold:    #ffd166;
            --c-blue:    #5599ff;
            --c-green:   #22ff88;
            --c-pink:    #ff44aa;
            --c-orange:  #ff8833;
        }
        body[data-theme="v1"] {
            --acc:       #3a99ff;
            --acc-dim:   #003399;
            --acc-glow:  rgba(58,153,255,0.42);
            --body-bg:   #030912;
            --panel-bg:  #060d1c;
            --panel-hd:  #080f22;
            --panel-bd:  #102244;
            --text-p:    #b8d0ff;
            --text-1:    #3a5580;
            --text-2:    #253858;
            --text-3:    #162240;
            --text-4:    #0f1830;
            --ticker-bg: #020509;
            --read-bg:   #040810;
            --c-gold:    #44aaff;
            --c-blue:    #77ccff;
            --c-green:   #33bbff;
            --c-pink:    #6688ff;
            --c-orange:  #4499ee;
        }
        body[data-theme="v2"] {
            --acc:       #ff1818;
            --acc-dim:   #aa0000;
            --acc-glow:  rgba(255,24,24,0.52);
            --body-bg:   #070202;
            --panel-bg:  #0d0404;
            --panel-hd:  #110505;
            --panel-bd:  #2a0606;
            --text-p:    #ffc8c8;
            --text-1:    #883333;
            --text-2:    #661818;
            --text-3:    #3a0d0d;
            --text-4:    #280808;
            --ticker-bg: #040101;
            --read-bg:   #060202;
            --c-gold:    #ff8855;
            --c-blue:    #ff5544;
            --c-green:   #ff4422;
            --c-pink:    #ff2266;
            --c-orange:  #ff7722;
        }
        body[data-theme="gabriel"] {
            --acc:       #c8981e;
            --acc-dim:   #6a5000;
            --acc-glow:  rgba(200,152,30,0.32);
            --body-bg:   #f0ebe0;
            --panel-bg:  #fafaf4;
            --panel-hd:  #edead8;
            --panel-bd:  #c8b880;
            --text-p:    #1a1508;
            --text-1:    #7a6a40;
            --text-2:    #a09060;
            --text-3:    #bfb080;
            --text-4:    #d0c898;
            --ticker-bg: #e5dfc8;
            --read-bg:   #f5f0e0;
            --c-gold:    #c8981e;
            --c-blue:    #3366aa;
            --c-green:   #227744;
            --c-pink:    #aa3366;
            --c-orange:  #bb5522;
        }

        .theme-bg-wrap { position: fixed; inset: 0; pointer-events: none; z-index: 1; overflow: hidden; }
        .bg-dark { position: absolute; inset: 0; display: none; }
        [data-theme="dark"] .bg-dark, [data-theme="v1"] .bg-dark { display: block; }
        .bg-dark-grid {
            position: absolute; inset: 0;
            background-image:
                linear-gradient(60deg,  transparent 49.5%, rgba(255,32,32,.025) 50%, transparent 50.5%),
                linear-gradient(120deg, transparent 49.5%, rgba(255,32,32,.018) 50%, transparent 50.5%),
                linear-gradient(0deg,   transparent 49.5%, rgba(255,32,32,.015) 50%, transparent 50.5%);
            background-size: 52px 90px;
        }
        [data-theme="v1"] .bg-dark-grid {
            background-image:
                linear-gradient(60deg,  transparent 49.5%, rgba(58,153,255,.03)  50%, transparent 50.5%),
                linear-gradient(120deg, transparent 49.5%, rgba(58,153,255,.022) 50%, transparent 50.5%),
                linear-gradient(0deg,   transparent 49.5%, rgba(58,153,255,.018) 50%, transparent 50.5%);
            background-size: 52px 90px;
        }
        .bg-dark-scan {
            position: absolute; left: 0; right: 0;
            height: 110px; top: -110px;
            background: linear-gradient(to bottom,
                transparent,
                rgba(255,32,32,.012) 42%, rgba(255,32,32,.028) 50%,
                rgba(255,32,32,.012) 58%, transparent);
            animation: darkScan 6s linear infinite;
        }
        [data-theme="v1"] .bg-dark-scan {
            background: linear-gradient(to bottom,
                transparent,
                rgba(58,153,255,.014) 42%, rgba(58,153,255,.032) 50%,
                rgba(58,153,255,.014) 58%, transparent);
            animation-duration: 5s;
        }
        @keyframes darkScan { from { transform: translateY(0); } to { transform: translateY(calc(100vh + 110px)); } }
        #theme-bg-canvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; }

        body::after {
            content: '';
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.12) 2px, rgba(0,0,0,0.12) 4px);
            pointer-events: none; z-index: 9999;
        }
        body[data-theme="gabriel"]::after {
            background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.03) 2px, rgba(0,0,0,0.03) 4px);
        }

        body {
            background: var(--body-bg); color: var(--text-p);
            font-family: 'Share Tech Mono', 'Fira Code', monospace;
            min-height: 100vh; overflow-x: hidden;
            transition: background 0.35s, color 0.35s;
        }
        .page { max-width: 1380px; margin: 0 auto; padding: 0 1rem 2rem; position: relative; z-index: 10; }

        /* ─── ШАПКА ─── */
        .site-header { border-bottom: 2px solid var(--acc); padding: 1.4rem 0 1rem; margin-bottom: 0; transition: border-color 0.35s; }
        .header-top { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; }
        .logo-eyebrow { font-size: 0.6rem; color: var(--acc); letter-spacing: 0.35em; text-transform: uppercase; margin-bottom: 0.25rem; }
        .logo-main { font-family: 'VT323', monospace; font-size: 4rem; line-height: 1; color: var(--text-p); letter-spacing: 3px; text-shadow: 0 0 24px var(--acc-glow), 2px 2px 0 var(--acc-dim); }
        .logo-main .v1 { color: var(--acc); text-shadow: 0 0 40px var(--acc), 0 0 80px var(--acc-glow); }
        @keyframes glitch {
            0%,100% { transform: translate(0); }
            15% { transform: translate(-2px,1px); clip-path: inset(30% 0 30% 0); }
            30% { transform: translate(2px,-1px); }
            50% { transform: translate(0); }
            65% { transform: translate(-1px,2px); clip-path: inset(60% 0 5% 0); }
        }
        .logo-main:hover { animation: glitch 0.25s steps(1) infinite; cursor: default; }
        .logo-tagline { font-size: 0.65rem; color: var(--text-2); letter-spacing: 0.2em; text-transform: uppercase; margin-top: 0.4rem; }

        /* ─── ТЕМА ─── */
        .theme-panel { background: var(--panel-bg); border: 1px solid var(--panel-bd); border-top: 2px solid var(--acc); padding: 0.75rem 0.95rem; min-width: 230px; transition: background 0.35s, border-color 0.35s; }
        .tp-head { font-size: 0.52rem; color: var(--text-2); letter-spacing: 0.25em; text-transform: uppercase; margin-bottom: 0.55rem; display: flex; align-items: center; gap: 0.4rem; }
        .tp-head::before { content: ''; width: 5px; height: 5px; flex-shrink: 0; background: var(--acc); box-shadow: 0 0 5px var(--acc); }
        .tp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
        .tp-btn { background: transparent; border: 1px solid var(--text-4); padding: 0.45rem 0.6rem; cursor: pointer; display: flex; align-items: center; gap: 7px; font-family: 'Share Tech Mono', monospace; color: var(--text-p); transition: 0.16s; text-align: left; position: relative; overflow: hidden; }
        .tp-btn::after { content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 2px; transition: width 0.18s; }
        .tp-btn:hover::after, .tp-btn.active::after { width: 100%; }
        .tp-swatch { width: 9px; height: 9px; flex-shrink: 0; transition: box-shadow 0.2s; }
        .t-dark    .tp-swatch { background: #aaaaaa; }
        .t-v1      .tp-swatch { background: #3a99ff; box-shadow: 0 0 6px #3a99ff; }
        .t-v2      .tp-swatch { background: #ff1818; box-shadow: 0 0 6px #ff1818; }
        .t-gabriel .tp-swatch { background: #c8981e; box-shadow: 0 0 6px #c8981e; }
        .t-dark::after    { background: #aaaaaa; }
        .t-v1::after      { background: #3a99ff; }
        .t-v2::after      { background: #ff1818; }
        .t-gabriel::after { background: #c8981e; }
        .tp-btn.t-dark:hover,    .tp-btn.t-dark.active    { border-color: #aaaaaa; background: rgba(180,180,180,0.07); }
        .tp-btn.t-v1:hover,      .tp-btn.t-v1.active      { border-color: #3a99ff; background: rgba(58,153,255,0.09); }
        .tp-btn.t-v2:hover,      .tp-btn.t-v2.active      { border-color: #ff1818; background: rgba(255,24,24,0.09); }
        .tp-btn.t-gabriel:hover, .tp-btn.t-gabriel.active { border-color: #c8981e; background: rgba(200,152,30,0.09); }
        .tp-info { display: flex; flex-direction: column; gap: 1px; }
        .tp-name { font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; }
        .tp-sub  { font-size: 0.48rem; color: var(--text-1); letter-spacing: 0.1em; text-transform: uppercase; }
        .tp-current { font-size: 0.47rem; color: var(--text-3); letter-spacing: 0.15em; text-transform: uppercase; text-align: right; margin-top: 0.45rem; }

        /* ─── ТИКЕР ─── */
        .ticker-wrap { background: var(--ticker-bg); border-top: 1px solid var(--text-4); border-bottom: 1px solid var(--text-4); overflow: hidden; padding: 0.28rem 0; margin-bottom: 1.2rem; }
        .ticker-inner { display: flex; gap: 4rem; animation: tick 28s linear infinite; white-space: nowrap; }
        @keyframes tick { from { transform: translateX(0); } to { transform: translateX(-50%); } }
        .ti   { font-size: 0.58rem; color: var(--text-2); letter-spacing: 0.2em; text-transform: uppercase; }
        .ti .r{ color: var(--acc); }

        /* ─── НАВИГАЦИЯ ─── */
        .nav-section { display: flex; align-items: stretch; gap: 1rem; margin-bottom: 1.4rem; flex-wrap: wrap; }
        .nav-home-indicator { background: var(--panel-bg); border: 1px solid var(--panel-bd); border-left: 3px solid var(--acc); padding: 1rem 1.2rem; display: flex; flex-direction: column; justify-content: center; min-width: 180px; }
        .nhi-label { font-size: 0.5rem; color: var(--text-2); letter-spacing: 0.3em; text-transform: uppercase; margin-bottom: 0.2rem; }
        .nhi-name  { font-family: 'VT323', monospace; font-size: 2rem; color: var(--acc); text-shadow: 0 0 12px var(--acc-glow); line-height: 1; }
        .nhi-sub   { font-size: 0.55rem; color: var(--text-1); letter-spacing: 0.15em; text-transform: uppercase; margin-top: 0.15rem; }
        .nhi-dot   { width: 6px; height: 6px; background: var(--acc); box-shadow: 0 0 6px var(--acc); display: inline-block; margin-right: 6px; }
        .nav-buttons-right { flex: 1; display: flex; gap: 4px; flex-wrap: wrap; }
        .nav-btn { flex: 1; min-width: 140px; background: var(--panel-bg); border: 1px solid var(--text-4); border-bottom: 3px solid var(--text-4); padding: 1.1rem 1rem; cursor: pointer; display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; text-decoration: none; color: var(--text-p); font-family: 'Share Tech Mono', monospace; transition: 0.15s; position: relative; overflow: hidden; gap: 0.5rem; }
        .nav-btn::before { content: ''; position: absolute; left: 0; top: 0; width: 3px; height: 100%; background: var(--text-4); transition: 0.15s; }
        .nav-btn::after { content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 3px; transition: width 0.2s; }
        .nav-btn:hover::after, .nav-btn.active::after { width: 100%; }
        .nb-blue  { --nc: var(--c-blue); }
        .nb-gold  { --nc: var(--c-gold); }
        .nb-red   { --nc: var(--acc); }
        .nb-pink  { --nc: var(--c-pink); }
        .nb-green { --nc: var(--c-green); }
        .nav-btn::after  { background: var(--nc); }
        .nav-btn::before { background: var(--text-4); }
        .nav-btn:hover, .nav-btn.active { border-color: var(--nc); background: color-mix(in srgb, var(--nc) 6%, var(--panel-bg)); }
        .nav-btn:hover::before, .nav-btn.active::before { background: var(--nc); box-shadow: 0 0 10px var(--nc); }
        .nav-btn:hover .nb-num, .nav-btn.active .nb-num  { color: var(--nc); }
        .nav-btn:hover .nb-icon, .nav-btn.active .nb-icon { color: var(--nc); text-shadow: 0 0 14px var(--nc); }
        .nb-top   { display: flex; justify-content: space-between; align-items: flex-start; width: 100%; }
        .nb-icon  { font-size: 1.6rem; line-height: 1; color: var(--text-2); transition: 0.15s; }
        .nb-num   { font-family: 'VT323', monospace; font-size: 2rem; color: var(--text-3); transition: 0.15s; line-height: 1; }
        .nb-name  { font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-p); font-weight: 600; }
        .nb-sub   { font-size: 0.52rem; color: var(--text-1); letter-spacing: 0.1em; text-transform: uppercase; margin-top: 0.1rem; }

        /* ─── КРАСНАЯ ЛИНИЯ ─── */
        .redline { height: 2px; background: linear-gradient(90deg, var(--acc) 0%, var(--text-p) 18%, var(--acc) 35%, transparent 100%); box-shadow: 0 0 10px var(--acc-glow); margin-bottom: 1.5rem; }

        /* ─── ОБЩИЕ ПАНЕЛИ ─── */
        .panel { background: var(--panel-bg); border: 1px solid var(--panel-bd); margin-bottom: 1.4rem; }
        .panel-head { background: var(--panel-hd); border-bottom: 1px solid var(--panel-bd); padding: 0.55rem 1rem; display: flex; align-items: center; gap: 0.7rem; }
        .ph-dot      { width: 10px; height: 10px; flex-shrink: 0; background: var(--acc); box-shadow: 0 0 8px var(--acc); }
        .ph-dot.gold { background: var(--c-gold); box-shadow: 0 0 8px var(--c-gold); }
        .ph-dot.blue { background: var(--c-blue); box-shadow: 0 0 8px var(--c-blue); }
        .ph-dot.green{ background: var(--c-green); box-shadow: 0 0 8px var(--c-green); }
        .ph-title    { font-family: 'VT323', monospace; font-size: 1.3rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-p); }
        .ph-title.gold  { color: var(--c-gold); }
        .ph-title.blue  { color: var(--c-blue); }
        .ph-title.green { color: var(--c-green); }
        .ph-tag { margin-left: auto; font-size: 0.55rem; color: var(--text-3); letter-spacing: 0.15em; }
        .panel-body { padding: 1rem 1.1rem; }

        .art-lead { font-family: 'VT323', monospace; font-size: 1.15rem; color: var(--acc); letter-spacing: 0.06em; line-height: 1.4; margin-bottom: 0.9rem; padding-bottom: 0.7rem; border-bottom: 1px solid var(--text-4); }
        .art-para { font-size: 0.74rem; color: var(--text-p); line-height: 1.85; margin-bottom: 0.8rem; }
        .art-para:last-child { margin-bottom: 0; }
        .art-hl { color: var(--acc); }
        .art-section-head { font-size: 0.6rem; color: var(--text-2); letter-spacing: 0.3em; text-transform: uppercase; margin: 1rem 0 0.5rem; display: flex; align-items: center; gap: 0.5rem; }
        .art-section-head::before { content: '//'; color: var(--acc); }

        .fact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin: 0.8rem 0; }
        .fact-item { background: var(--panel-hd); border: 1px solid var(--text-4); border-left: 2px solid var(--acc); padding: 0.55rem 0.75rem; }
        .fact-key { font-size: 0.52rem; color: var(--text-2); letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 0.2rem; }
        .fact-val { font-family: 'VT323', monospace; font-size: 1rem; color: var(--text-p); }
        .fact-val.r { color: var(--acc); }
        .fact-val.g { color: var(--c-gold); }
        .fact-val.b { color: var(--c-blue); }
        .fact-val.n { color: var(--c-green); }

        .readout { background: var(--read-bg); border: 1px solid var(--text-4); padding: 0.6rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.62rem; color: var(--text-2); line-height: 1.9; margin-top: 0.8rem; }
        .readout .hl { color: var(--acc); }
        .readout .vl { color: var(--text-1); }

        .tags { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 0.5rem; }
        .tag { background: var(--panel-hd); border: 1px solid var(--text-4); padding: 0.08rem 0.45rem; font-size: 0.57rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-2); }
        .tag.r { border-color: var(--acc);    color: var(--acc); }
        .tag.g { border-color: var(--c-gold); color: var(--c-gold); }
        .tag.b { border-color: var(--c-blue); color: var(--c-blue); }
        .tag.n { border-color: var(--c-green);color: var(--c-green); }

        /* ─── СЕКТОРЫ — СПЕЦИФИЧЕСКИЕ СТИЛИ ─── */
        .sectors-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; }
        .layer-full  { grid-column: 1 / -1; }

        .act-banner {
            grid-column: 1 / -1;
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.6rem 1rem;
            background: var(--panel-hd);
            border: 1px solid var(--panel-bd);
            border-left: 4px solid var(--acc);
            margin-bottom: 0;
        }
        .act-banner-num { font-family: 'VT323', monospace; font-size: 2.4rem; color: var(--acc); text-shadow: 0 0 14px var(--acc-glow); line-height: 1; min-width: 60px; }
        .act-banner-title { font-family: 'VT323', monospace; font-size: 1.5rem; color: var(--text-p); letter-spacing: 0.12em; text-transform: uppercase; }
        .act-banner-sub { font-size: 0.55rem; color: var(--text-2); letter-spacing: 0.2em; text-transform: uppercase; margin-top: 0.15rem; }
        .act-banner-tag { margin-left: auto; font-size: 0.5rem; color: var(--text-3); letter-spacing: 0.15em; text-align: right; }

        /* ─── КАРТОЧКА СЛОЯ ─── */
        .layer-panel {
            background: var(--panel-bg);
            border: 1px solid var(--panel-bd);
            border-left: 3px solid var(--lc, var(--acc));
            position: relative;
            overflow: hidden;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .layer-panel:hover {
            box-shadow: -4px 0 18px var(--lc-glow, var(--acc-glow));
        }
        .layer-panel-head {
            background: var(--panel-hd);
            border-bottom: 1px solid var(--panel-bd);
            padding: 0.6rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.8rem;
            position: relative;
        }
        .lph-num {
            font-family: 'VT323', monospace;
            font-size: 2.2rem;
            color: var(--lc, var(--acc));
            text-shadow: 0 0 14px var(--lc-glow, var(--acc-glow));
            line-height: 1;
            min-width: 52px;
            text-align: center;
        }
        .lph-info { flex: 1; }
        .lph-layer-label { font-size: 0.48rem; color: var(--text-2); letter-spacing: 0.3em; text-transform: uppercase; margin-bottom: 0.1rem; }
        .lph-name { font-family: 'VT323', monospace; font-size: 1.5rem; color: var(--text-p); letter-spacing: 0.1em; line-height: 1; }
        .lph-name-en { font-size: 0.6rem; color: var(--lc, var(--acc)); letter-spacing: 0.2em; text-transform: uppercase; margin-top: 0.1rem; }
        .lph-status {
            font-size: 0.5rem;
            padding: 0.18rem 0.5rem;
            border: 1px solid var(--lc, var(--acc));
            color: var(--lc, var(--acc));
            letter-spacing: 0.15em;
            text-transform: uppercase;
            background: transparent;
        }
        .lph-status.done { border-color: var(--c-green); color: var(--c-green); }
        .lph-status.dev  { border-color: var(--c-gold);  color: var(--c-gold); }

        /* BIG ghost number */
        .layer-ghost-num {
            position: absolute;
            right: -0.1rem;
            top: 50%;
            transform: translateY(-50%);
            font-family: 'VT323', monospace;
            font-size: 5.5rem;
            color: var(--lc, var(--acc));
            opacity: 0.045;
            line-height: 1;
            pointer-events: none;
            letter-spacing: -4px;
        }

        .layer-body { padding: 0.9rem 1rem; }

        .layer-desc { font-size: 0.71rem; color: var(--text-p); line-height: 1.8; margin-bottom: 0.8rem; }
        .layer-desc .hl { color: var(--lc, var(--acc)); }

        .section-label {
            font-size: 0.52rem;
            color: var(--text-2);
            letter-spacing: 0.28em;
            text-transform: uppercase;
            margin: 0.75rem 0 0.4rem;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }
        .section-label::before { content: '//'; color: var(--lc, var(--acc)); font-size: 0.6rem; }

        /* Список уровней */
        .level-list { list-style: none; }
        .level-item {
            display: flex;
            align-items: flex-start;
            gap: 0.65rem;
