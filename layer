        for(var kk=0;kk<18;kk++){var mang=(kk/18)*Math.PI*2;CTX.beginPath();CTX.moveTo(0,0);CTX.lineTo(Math.cos(mang)*mR,Math.sin(mang)*mR);CTX.strokeStyle='rgba(200,152,30,'+mA+')';CTX.lineWidth=.45;CTX.stroke();}
        CTX.restore();
        S.wings.forEach(function(w){w.ph+=w.phs;var a=w.al*(.5+.5*Math.sin(w.ph));var span=Math.min(cx*.96,265);var beat=Math.sin(w.ph*.46)*w.beatA;CTX.save();CTX.strokeStyle='rgba(175,138,18,'+a+')';CTX.lineWidth=.75;for(var f=0;f<8;f++){var t=(f+1)/9;var arcY=cy-58*(1-t)-f*7+beat*span*t;CTX.beginPath();CTX.moveTo(cx,cy);CTX.quadraticCurveTo(cx+w.side*span*t*.44,arcY,cx+w.side*span*t,cy+18+f*13+beat*span*.26);CTX.stroke();}CTX.restore();});
        S.halos.forEach(function(hh){hh.ph+=hh.phs;hh.rot+=hh.rotV;var a=hh.al*(.44+.56*Math.sin(hh.ph));var rr=hh.rr*(.93+.07*Math.sin(hh.ph*1.22));CTX.beginPath();CTX.arc(hh.x,hh.y,rr,0,Math.PI*2);CTX.strokeStyle='rgba(200,152,30,'+a+')';CTX.lineWidth=1.5;CTX.stroke();});
        S.motes.forEach(function(m,idx){m.ph+=m.phs;m.y+=m.vy;m.x+=m.vx+Math.sin(m.ph*.64)*.09;if(m.y<-28){S.motes[idx]=newMote(false);return;}var a=m.al*(.36+.64*Math.abs(Math.sin(m.ph)));CTX.beginPath();CTX.arc(m.x,m.y,m.rr,0,Math.PI*2);CTX.fillStyle='rgba(225,182,62,'+a+')';CTX.fill();});
        S.inscT--;if(S.inscT<=0){S.inscT=ri(70,180);if(S.inscriptions.length<10)S.inscriptions.push(newInscription());}
        S.inscriptions=S.inscriptions.filter(function(ins){return ins.life>0;});
        S.inscriptions.forEach(function(ins){ins.life-=ins.decay;ins.ph+=ins.phs;var a=ins.al*ins.life*(.48+.52*Math.sin(ins.ph));if(a<.003)return;CTX.font=ins.size+'px "Share Tech Mono",monospace';CTX.fillStyle='rgba(200,152,30,'+a+')';CTX.fillText(ins.txt,ins.x,ins.y);});
        S.feathers.forEach(function(f,idx){f.sw+=f.sws;f.y+=f.vy;f.x+=f.vx+Math.sin(f.sw)*.13;f.rot=Math.sin(f.sw*.5)*.3;if(f.y>H+110){S.feathers[idx]=newFeather(false);return;}drawFeather(f.x,f.y,f.len,f.rot,f.al,f.golden);});
        if(Math.random()<.0022)S.divFlash=r(.55,1.3);
        if(S.divFlash>0){CTX.fillStyle='rgba(255,232,130,'+(S.divFlash*.025)+')';CTX.fillRect(0,0,W,H);S.divFlash-=.055;}
    }
    function drawFeather(x,y,len,rot,al,golden){var shaft=golden?'200,152,30':'172,142,72';CTX.save();CTX.translate(x,y);CTX.rotate(rot);CTX.beginPath();CTX.moveTo(0,-len*.5);CTX.lineTo(0,len*.5);CTX.strokeStyle='rgba('+shaft+','+al+')';CTX.lineWidth=.9;CTX.stroke();var steps=Math.floor(len/3.4);for(var i=0;i<steps;i++){var t=i/steps,by=-len*.5+t*len,bw=Math.sin(t*Math.PI)*len*.38,ba=al*Math.sin(t*Math.PI);if(ba<.003)continue;CTX.strokeStyle='rgba('+shaft+','+ba+')';CTX.lineWidth=.4;CTX.beginPath();CTX.moveTo(0,by);CTX.quadraticCurveTo(bw*.44,by+len*.05,bw,by+len*.044);CTX.stroke();CTX.beginPath();CTX.moveTo(0,by);CTX.quadraticCurveTo(-bw*.44,by+len*.05,-bw,by+len*.044);CTX.stroke();}CTX.restore();}

    function loop() {
        switch(AT) {
            case 'v2':      drawV2();      break;
            case 'gabriel': drawGabriel(); break;
            default: CTX.clearRect(0,0,CV.width,CV.height); break;
        }
        requestAnimationFrame(loop);
    }

    function init(t) {
        AT=t; S={};
        switch(t) {
            case 'v2':      initV2();      break;
            case 'gabriel': initGabriel(); break;
        }
    }

    var _orig = window.setTheme;
    window.setTheme = function(t) { _orig(t); init(t); };

    var boot = 'dark';
    try { boot = localStorage.getItem('uk_theme') || 'dark'; } catch(e) {}
    init(boot);
    loop();
})();
